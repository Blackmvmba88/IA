{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPME Tourbillon Research Topology",
  "type": "object",
  "required": ["id", "status", "axes", "oscillator", "energy_model"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["simulation-only", "cad-only", "prototype-approved"]},
    "axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "direction", "period_s"],
        "properties": {
          "id": {"type": "string"},
          "direction": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "period_s": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "oscillator": {
      "type": "object",
      "required": ["frequency_hz"],
      "properties": {
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "target_amplitude_deg": {"type": ["number", "null"]}
      }
    },
    "energy_model": {
      "type": "object",
      "required": ["cage_inertia_kg_m2", "friction_torque_nm"],
      "properties": {
        "cage_inertia_kg_m2": {"type": "number", "minimum": 0},
        "friction_torque_nm": {"type": "number", "minimum": 0},
        "constant_force": {"type": "boolean"}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
