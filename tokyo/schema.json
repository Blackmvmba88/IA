{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TOKYO Movement Intent",
  "type":"object",
  "required":["id","oscillator","displays"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "oscillator":{
      "type":"object",
      "required":["frequency_hz"],
      "properties":{
        "frequency_hz":{"type":"number","exclusiveMinimum":0}
      },
      "additionalProperties":false
    },
    "displays":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["id","period_s"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "source_id":{"type":["string","null"]},
          "period_s":{"type":"number","exclusiveMinimum":0},
          "radius_mm":{"type":["number","null"],"exclusiveMinimum":0},
          "z_mm":{"type":["number","null"]},
          "kind":{"enum":["hand","disk","orbital","cage","internal","other"]}
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false
}
